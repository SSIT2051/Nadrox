#!/bin/bash
# Generated by CMake - copy art_standalone artifacts to local source out/host
set -e

ART_SOURCE_DIR="@ART_SOURCE_DIR@"
ART_BUILD_DIR="@ART_BUILD_DIR@"
ART_HOST_ARCH="@ART_HOST_ARCH@"
ART_HOST_LIBDIR="@ART_HOST_LIBDIR@"

echo "Copying art_standalone artifacts from ${ART_BUILD_DIR}/src/out/host/${ART_HOST_ARCH} to ${ART_SOURCE_DIR}/out/host/${ART_HOST_ARCH}"

mkdir -p "${ART_SOURCE_DIR}/out/host/${ART_HOST_ARCH}/${ART_HOST_LIBDIR}"
mkdir -p "${ART_SOURCE_DIR}/out/host/${ART_HOST_ARCH}/bin"
mkdir -p "${ART_SOURCE_DIR}/out/host/${ART_HOST_ARCH}/framework"

# Copy shared libraries
if [ -d "${ART_BUILD_DIR}/src/out/host/${ART_HOST_ARCH}/${ART_HOST_LIBDIR}" ]; then
    cp -f "${ART_BUILD_DIR}/src/out/host/${ART_HOST_ARCH}/${ART_HOST_LIBDIR}"/*.so \
        "${ART_SOURCE_DIR}/out/host/${ART_HOST_ARCH}/${ART_HOST_LIBDIR}/" 2>/dev/null || true
    echo "Copied shared libraries"
fi

# Copy binaries
if [ -d "${ART_BUILD_DIR}/src/out/host/${ART_HOST_ARCH}/bin" ]; then
    cp -f "${ART_BUILD_DIR}/src/out/host/${ART_HOST_ARCH}/bin/"* \
        "${ART_SOURCE_DIR}/out/host/${ART_HOST_ARCH}/bin/" 2>/dev/null || true
    echo "Copied binaries"
fi

# Copy framework JARs
if [ -d "${ART_BUILD_DIR}/src/out/host/${ART_HOST_ARCH}/framework" ]; then
    cp -f "${ART_BUILD_DIR}/src/out/host/${ART_HOST_ARCH}/framework"/*.jar \
        "${ART_SOURCE_DIR}/out/host/${ART_HOST_ARCH}/framework/" 2>/dev/null || true
    echo "Copied framework JARs"
fi

echo "Artifact copy complete"